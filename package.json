{
  "version": "0.0.0",
  "license": "ISC",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": "24.16.0",
    "pnpm": "10.24.0"
  },
  "scripts": {
    "prepare": "effect-tsgo patch",
    "build": "corepack pnpm -r --if-present run build",
    "test": "corepack pnpm -r --if-present run test",
    "clean": "corepack pnpm -r --if-present run clean",
    "format": "prettier --ignore-path .gitignore --write \"{packages,examples,test-site}/**/*.{ts,tsx}\"",
    "format-check": "prettier --ignore-path .gitignore --check \"{packages,examples,test-site}/**/*.{ts,tsx}\"",
    "lint": "eslint --config eslint.config.mts \"packages/**/src/**/*.{ts,tsx}\" \"test-site/src/**/*.{ts,tsx}\" --max-warnings 0",
    "lint:fix": "eslint --config eslint.config.mts 'packages/**/*.{ts,tsx}' --fix",
    "typecheck": "tsgo --noEmit --project packages/web/tsconfig.json && tsgo --noEmit --project packages/react/tsconfig.json && tsgo --noEmit --project test-site/tsconfig.json",
    "verify:web-build-reproducible": "node scripts/verify-web-build-reproducibility.mjs",
    "build-test-site": "./test-site/build.sh",
    "serve-test-site": "http-server ./test-site/dist",
    "dev": "./scripts/dev.sh",
    "release-all": "corepack pnpm -r --if-present run release"
  },
  "private": true,
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@eslint/js": "^9.38.0",
    "@esm-bundle/chai": "^4.3.4-fix.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "catalog:",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@web/dev-server-esbuild": "^1.0.4",
    "@web/test-runner": "^0.20.2",
    "esbuild": "^0.17.10",
    "eslint": "^9.38.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.4.0",
    "http-server": "^14.1.1",
    "jiti": "^2.6.1",
    "live-server": "^1.2.2",
    "nodemon": "^3.0.2",
    "prettier": "^2.6.2",
    "prettier-plugin-organize-imports": "^4.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.46.2"
  },
  "workspaces": [
    "packages/web",
    "packages/react"
  ],
  "dependencies": {}
}
